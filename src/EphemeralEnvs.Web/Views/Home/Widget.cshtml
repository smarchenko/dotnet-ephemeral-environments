@{
    ViewData["Title"] = "Products (widget)";
}

<h1>Products</h1>
<p class="text-muted">
    Rendered in the browser: <code>widget.js</code> calls the API directly through <code>Api__PublicBaseUrl</code> (CORS).
</p>

<form id="product-form" class="row g-2 align-items-end mb-3" novalidate>
    <div class="col-sm-5">
        <label for="product-name" class="form-label">Name</label>
        <input id="product-name" name="name" class="form-control" maxlength="200" />
    </div>
    <div class="col-sm-3">
        <label for="product-price" class="form-label">Price</label>
        <input id="product-price" name="price" class="form-control" type="number" step="0.01" min="0.01" />
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<div id="widget-error" class="alert alert-danger d-none" role="alert"></div>

<table class="table">
    <thead>
        <tr><th>Name</th><th class="text-end">Price</th><th>Created</th></tr>
    </thead>
    <tbody id="product-list">
        <tr><td colspan="3" class="text-muted">Loading…</td></tr>
    </tbody>
</table>

@section Scripts {
    <script src="~/js/widget.js" asp-append-version="true"></script>
}
