@using System.Globalization
@using EphemeralEnvs.Contracts
@model HomeIndexModel
@{
    ViewData["Title"] = "Products (server-side)";
    var now = DateTimeOffset.UtcNow;
}

<h1>Products</h1>
<p class="text-muted">Rendered on the server: the Web calls the API through <code>Api__InternalBaseUrl</code>.</p>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
else
{
    @* Situation E: the Web's ProductStats flag is on; the API may still have it off (404) or fail. *@
    @if (Model.ShowStats)
    {
        <div id="product-stats" class="card card-body mb-3">
            @if (Model.Stats is { } stats)
            {
                <span>
                    @stats.Count products
                    @if (stats.AveragePrice is { } average)
                    {
                        <text> · average @average.ToString("0.00", CultureInfo.InvariantCulture)</text>
                    }
                    @if (stats.NewestCreatedAt is { } newest)
                    {
                        <text> · newest @newest.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</text>
                    }
                </span>
            }
            else
            {
                <span class="text-muted">@Model.StatsMessage</span>
            }
        </div>
    }

    @if (Model.Products.Count == 0)
    {
        <p>No products yet. Add one on the <a asp-action="Widget">Widget</a> page.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Name</th><th class="text-end">Price</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            @product.Name
                            @* Situation C: the view decides with the feature tag helper; no API involved. *@
                            @if (HomeIndexModel.IsNew(product, now))
                            {
                                <feature name="@FeatureFlags.NewBadge"><span class="badge text-bg-success">New</span></feature>
                            }
                        </td>
                        <td class="text-end">@product.Price.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td>@product.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
