@using EphemeralEnvs.Contracts
@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Products (server-side)";
}

<h1>Products</h1>
<p class="text-muted">Rendered on the server: the Web calls the API through <code>Api__InternalBaseUrl</code>.</p>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
else if (Model.Count == 0)
{
    <p>No products yet. Add one on the <a asp-action="Widget">Widget</a> page.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th class="text-end">Price</th><th>Created</th></tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td class="text-end">@product.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@product.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
}
